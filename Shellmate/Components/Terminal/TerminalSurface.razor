@namespace Shellmate.Components.Terminal
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="terminal-surface @CssClass">
    <div class="terminal-root" @ref="_terminalEl"></div>
</div>

@code {
    [Parameter] public EventCallback<string> OnInput { get; set; }
    [Parameter] public EventCallback<TerminalSize> OnResize { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private ElementReference _terminalEl;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TerminalSurface>? _dotNetRef;
    private TerminalSize _size = TerminalSize.Default;
    private bool _disposed;

    public TerminalSize CurrentSize => _size;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Terminal/TerminalSurface.razor.js");
        if (_disposed)
        {
            await DisposeModuleAsync(module);
            return;
        }

        _module = module;
        _dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            var size = await module.InvokeAsync<TerminalSize>("initialize", _terminalEl, _dotNetRef);
            if (_disposed)
                return;

            _size = Normalize(size);
            await OnResize.InvokeAsync(_size);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
    }

    public async Task WriteAsync(string data)
    {
        if (_disposed || _module is null || string.IsNullOrEmpty(data))
            return;

        try
        {
            await _module.InvokeVoidAsync("write", _terminalEl, data);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
    }

    public async Task ResetAsync()
    {
        if (_disposed || _module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("reset", _terminalEl);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
    }

    public async Task<TerminalSize> FitAsync()
    {
        if (_disposed || _module is null)
            return _size;

        try
        {
            var size = await _module.InvokeAsync<TerminalSize>("fit", _terminalEl);
            _size = Normalize(size);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }

        return _size;
    }

    public async Task FocusAsync()
    {
        if (_disposed || _module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("focus", _terminalEl);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
    }

    [JSInvokable]
    public async Task ReceiveInput(string data)
    {
        if (!_disposed && !string.IsNullOrEmpty(data))
            await OnInput.InvokeAsync(data);
    }

    [JSInvokable]
    public async Task ReceiveResize(int cols, int rows)
    {
        if (_disposed)
            return;

        _size = Normalize(new TerminalSize(cols, rows));
        await OnResize.InvokeAsync(_size);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        var module = _module;
        _module = null;

        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose", _terminalEl); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            await DisposeModuleAsync(module);
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private static async ValueTask DisposeModuleAsync(IJSObjectReference module)
    {
        try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
    }

    private static TerminalSize Normalize(TerminalSize size) =>
        new(Math.Max(2, size.Cols), Math.Max(1, size.Rows));
}
