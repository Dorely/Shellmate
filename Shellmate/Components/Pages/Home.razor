@page "/"
@page "/chat"
@using System.Text
@using System.Text.Json
@using Microsoft.Extensions.AI
@using Shellmate.Chat
@using Shellmate.Llm
@using Shellmate.Models
@using Shellmate.Notes
@using Shellmate.Tokens
@implements IAsyncDisposable
@inject IAssistantChatService ChatService
@inject IWorkspaceChatRuntime ChatRuntime
@inject ILlmProviderService ProviderService
@inject ITerminalConnectionService ConnectionService
@inject IConnectionNoteService NoteService
@inject ITerminalSessionService TerminalSession
@inject IWorkspaceConnectionContext WorkspaceConnection
@inject AssistantToolRegistry ToolRegistry
@inject ITokenCounter TokenCounter
@inject NavigationManager Nav

<PageTitle>Shellmate</PageTitle>

@if (_redirecting)
{
    <div class="workspace-loading"><em>Opening connection settings...</em></div>
}
else
{
    <div class="workspace">
        <section class="workspace-chat">
            <ChatSurface Title="Shellmate"
                         Subtitle="@_providerSubtitle"
                         TokenText="@ConversationTokenText"
                         TokenTitle="@ConversationTokenTitle"
                         Loading="@_loading"
                         Messages="@_messages"
                         Live="@_live"
                         Error="@_error"
                         Input="@_input"
                         InputChanged="OnInputChanged"
                         Placeholder="Ask Shellmate..."
                         Running="@_running"
                         ComposerDisabled="@(_loading || !_hasWorkingProvider)"
                         SendDisabled="@(_loading || _running || !_hasWorkingProvider || string.IsNullOrWhiteSpace(_input))"
                         ForceScrollKey="@_forceScrollKey"
                         ScrollKey="@_scrollKey"
                         ResetComposerKey="@_resetComposerKey"
                         OnSend="SendAsync"
                         OnStop="StopAsync"
                         OnClearError="ClearError">
                <HeaderActions>
                    <a class="btn btn-sm btn-outline-secondary" href="settings/providers">Providers</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_running" @onclick="ResetAsync">Reset</button>
                </HeaderActions>
            </ChatSurface>
        </section>

        <section class="workspace-terminal" aria-label="Terminal workspace">
            <div class="terminal-header">
                <div class="terminal-heading">
                    <span class="terminal-title">Terminal</span>
                    <span class="terminal-subtitle">@_terminalStatus</span>
                </div>
                <div class="terminal-actions">
                    <select class="form-select form-select-sm terminal-select"
                            disabled="@(_connections.Count == 0 || _connecting || _terminalConnected)"
                            value="@SelectedConnectionValue"
                            @onchange="OnSelectedConnectionChangedAsync">
                        @foreach (var connection in _connections)
                        {
                            <option value="@connection.Id">@connection.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@(_selectedConnectionId is null)"
                            @onclick="OpenNotes">
                        Notes
                    </button>
                    @if (_terminalConnected)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DisconnectTerminalAsync">Disconnect</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary"
                                disabled="@(_connecting || !_terminalReady || _selectedConnectionId is null)"
                                @onclick="() => ConnectTerminalAsync(false)">
                            @(_connecting ? "Connecting..." : "Connect")
                        </button>
                    }
                    <a class="btn btn-sm btn-outline-secondary" href="settings/connections">Connections</a>
                </div>
            </div>

            @if (_hostKeyPrompt is not null)
            {
                <div class="terminal-host-key-alert">
                    <div>
                        <strong>Trust SSH host key?</strong>
                        <span>@_hostKeyPrompt.Host:@_hostKeyPrompt.Port reports @_hostKeyPrompt.HostKeyName @(_hostKeyPrompt.KeyBits)-bit key.</span>
                        <code>SHA256:@_hostKeyPrompt.FingerprintSha256</code>
                    </div>
                    <div class="terminal-host-key-actions">
                        <button type="button" class="btn btn-sm btn-warning" disabled="@_connecting" @onclick="() => ConnectTerminalAsync(true)">Trust and reconnect</button>
                        <button type="button" class="btn btn-sm btn-link" @onclick="DismissHostKeyPrompt">Cancel</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_terminalError))
            {
                <div class="terminal-error">
                    <span>@_terminalError</span>
                    <button type="button" class="btn-close btn-close-sm" @onclick="ClearTerminalError"></button>
                </div>
            }

            <TerminalSurface @ref="_terminal"
                             CssClass="workspace-terminal-surface"
                             OnInput="SendTerminalInputAsync"
                             OnResize="ResizeTerminalAsync" />
        </section>
    </div>

    <ConnectionNotesDrawer @ref="_notesDrawer"
                           Open="@_notesOpen"
                           OpenChanged="OnNotesOpenChangedAsync"
                           ConnectionId="@_selectedConnectionId"
                           ConnectionName="@SelectedConnectionName" />
}

@code {
    private const string ConversationTokenUnitLabel = "input tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    private readonly List<ChatRenderableMessage> _messages = [];
    private readonly List<AssistantMessage> _persistedMessages = [];
    private readonly List<TerminalConnection> _connections = [];
    private List<string> _toolDefinitions = [];
    private ChatLiveTurn? _live;
    private CancellationTokenSource? _outputCts;
    private TerminalSurface? _terminal;
    private ConnectionNotesDrawer? _notesDrawer;
    private LlmProvider? _activeProvider;
    private TerminalSize _terminalSize = TerminalSize.Default;
    private TerminalHostKeyPrompt? _hostKeyPrompt;
    private Guid? _selectedConnectionId;
    private string _input = string.Empty;
    private string? _pendingUserText;
    private string _systemPrompt = string.Empty;
    private AssistantNoteContext _noteContext = AssistantNoteContext.Unavailable("No workspace connection is selected.");
    private string? _error;
    private string? _terminalError;
    private string _providerSubtitle = "Checking provider status...";
    private string _terminalStatus = "Select a connection to open a terminal.";
    private bool _loading = true;
    private bool _running;
    private bool _connecting;
    private bool _terminalConnected;
    private bool _terminalReady;
    private bool _redirecting;
    private bool _hasWorkingProvider;
    private bool _notesOpen;
    private bool _disposed;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private int _forceScrollKey;
    private int _scrollKey;
    private int _resetComposerKey;

    private string? ConversationTokenText => _hasWorkingProvider
        ? _conversationTokens.Text(ConversationTokenUnitLabel)
        : null;

    private string? ConversationTokenTitle => _hasWorkingProvider
        ? _conversationTokens.Title(ConversationTokenTitleLabel)
        : null;

    private string SelectedConnectionValue => _selectedConnectionId?.ToString() ?? string.Empty;

    private string? SelectedConnectionName => _connections
        .FirstOrDefault(connection => connection.Id == _selectedConnectionId)
        ?.Name;

    protected override async Task OnInitializedAsync()
    {
        TerminalSession.StateChanged += OnTerminalStateChanged;
        ChatRuntime.StateChanged += OnChatRuntimeStateChanged;
        ChatRuntime.NotesChanged += OnChatRuntimeNotesChanged;
        await ReloadAsync();
        ApplyChatRuntimeSnapshot(ChatRuntime.GetSnapshot());
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _messages.Clear();
        _persistedMessages.Clear();
        _connections.Clear();

        var conversation = await ChatService.GetOrCreateAsync();
        var persistedMessages = await ChatService.LoadMessagesAsync(conversation.Id);
        _persistedMessages.AddRange(persistedMessages);
        _messages.AddRange(ToRenderable(_persistedMessages));
        _connections.AddRange(await ConnectionService.ListAsync());
        if (_connections.Count == 0)
        {
            SetSelectedConnection(null);
            _redirecting = true;
            Nav.NavigateTo("settings/connections?returnUrl=/", replace: true);
            return;
        }

        _selectedConnectionId ??= WorkspaceConnection.SelectedConnectionId;
        if (_selectedConnectionId is null || _connections.All(connection => connection.Id != _selectedConnectionId))
        {
            var activeConnectionId = TerminalSession.ActiveConnection?.Id;
            _selectedConnectionId = activeConnectionId is Guid id && _connections.Any(connection => connection.Id == id)
                ? id
                : _connections[0].Id;
        }
        SetSelectedConnection(_selectedConnectionId);
        UpdateTerminalStateFromRuntime();

        var availability = await ProviderService.GetDefaultChatProviderAvailabilityAsync();
        _hasWorkingProvider = availability.IsAvailable && availability.Provider is not null;
        _activeProvider = _hasWorkingProvider ? availability.Provider : null;
        _providerSubtitle = _hasWorkingProvider
            ? $"Default provider: {availability.Provider!.DisplayName ?? availability.Provider.Name} / {availability.Provider.ModelId}"
            : availability.Message;
        await RefreshConversationTokenInputsAsync();

        _loading = false;
        _forceScrollKey++;
        ApplyChatRuntimeSnapshot(ChatRuntime.GetSnapshot());
    }

    private void StartTerminalOutputPump()
    {
        if (_outputCts is not null)
            return;

        var outputCts = new CancellationTokenSource();
        var cancellationToken = outputCts.Token;
        _outputCts = outputCts;

        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var output in TerminalSession.SubscribeOutputAsync(includeReplay: true, cancellationToken))
                {
                    await InvokeAsync(async () =>
                    {
                        if (_disposed || cancellationToken.IsCancellationRequested)
                            return;

                        switch (output.Kind)
                        {
                            case TerminalOutputKind.Data:
                                if (_terminal is not null)
                                    await _terminal.WriteAsync(output.Text);
                                break;
                            case TerminalOutputKind.Status:
                                _terminalStatus = output.Text;
                                if (_terminal is not null)
                                    await _terminal.WriteAsync($"\r\n\x1b[2m{output.Text}\x1b[0m\r\n");
                                break;
                            case TerminalOutputKind.Error:
                                _terminalError = output.Text;
                                _terminalStatus = "Terminal error.";
                                if (_terminal is not null)
                                    await _terminal.WriteAsync($"\r\n\x1b[31m{output.Text}\x1b[0m\r\n");
                                break;
                            case TerminalOutputKind.Exited:
                                _terminalConnected = false;
                                _terminalStatus = output.Text;
                                if (_terminal is not null)
                                    await _terminal.WriteAsync($"\r\n\x1b[2m{output.Text}\x1b[0m\r\n");
                                break;
                        }

                        RefreshConversationTokenInputs();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
            }
            catch (ObjectDisposedException) when (_disposed || cancellationToken.IsCancellationRequested)
            {
            }
        });
    }

    private void OnTerminalStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            UpdateTerminalStateFromRuntime();
            RefreshConversationTokenInputs();
            StateHasChanged();
        });
    }

    private void OnChatRuntimeStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var wasRunning = _running;
            var snapshot = ChatRuntime.GetSnapshot();
            ApplyChatRuntimeSnapshot(snapshot);
            if (wasRunning && !snapshot.Running)
            {
                await ReloadAsync();
                StateHasChanged();
                return;
            }

            _scrollKey++;
            StateHasChanged();
        });
    }

    private void OnChatRuntimeNotesChanged()
    {
        _ = InvokeAsync(RefreshNotesAfterToolAsync);
    }

    private void ApplyChatRuntimeSnapshot(WorkspaceChatRuntimeSnapshot snapshot)
    {
        _running = snapshot.Running;
        _live = snapshot.Live;
        _pendingUserText = snapshot.PendingUserText;
        _error = snapshot.Error;
        UpdateConversationTokenCount();
    }

    private void UpdateTerminalStateFromRuntime()
    {
        _terminalConnected = TerminalSession.IsConnected;
        if (_terminalConnected)
        {
            _terminalStatus = $"Connected to {TerminalSession.ActiveConnection?.Name ?? "terminal"}.";
            return;
        }

        if (_connecting)
            return;

        _terminalStatus = _selectedConnectionId is null
            ? "Select a connection to open a terminal."
            : "Terminal is not connected.";
    }

    private Task OnInputChanged(string value)
    {
        _input = value;
        return Task.CompletedTask;
    }

    private async Task SendAsync()
    {
        if (_running || string.IsNullOrWhiteSpace(_input))
            return;

        var text = _input.Trim();
        _input = string.Empty;
        _resetComposerKey++;
        _error = null;
        _pendingUserText = text;

        _messages.Add(new ChatRenderableMessage(
            Guid.NewGuid(),
            ChatMessageRole.User,
            ChatMessageStatus.Completed,
            [new ChatTextPart(text)]));
        UpdateConversationTokenCount();
        _scrollKey++;

        try
        {
            await ChatRuntime.StartTurnAsync(text);
            ApplyChatRuntimeSnapshot(ChatRuntime.GetSnapshot());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _running = false;
            _pendingUserText = null;
            UpdateConversationTokenCount();
        }
    }

    private Task StopAsync()
    {
        return ChatRuntime.StopTurnAsync();
    }

    private async Task ResetAsync()
    {
        if (_running)
            return;

        await ChatRuntime.ResetConversationAsync();
        _error = null;
        _input = string.Empty;
        _pendingUserText = null;
        _live = null;
        _resetComposerKey++;
        await ReloadAsync();
    }

    private void ClearError()
    {
        _error = null;
        ChatRuntime.ClearError();
    }

    private async Task OnSelectedConnectionChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Guid.TryParse(value, out var connectionId))
            connectionId = Guid.Empty;

        SetSelectedConnection(connectionId == Guid.Empty ? null : connectionId);
        _hostKeyPrompt = null;
        _terminalError = null;
        await RefreshConversationTokenInputsAsync();

        if (_notesDrawer is not null)
            await _notesDrawer.RefreshAsync();
    }

    private void SetSelectedConnection(Guid? connectionId)
    {
        _selectedConnectionId = connectionId;
        WorkspaceConnection.SetSelectedConnection(connectionId);
    }

    private void OpenNotes()
    {
        _notesOpen = true;
    }

    private Task OnNotesOpenChangedAsync(bool open)
    {
        _notesOpen = open;
        return Task.CompletedTask;
    }

    private async Task RefreshNotesAfterToolAsync()
    {
        if (_notesDrawer is not null)
            await _notesDrawer.RefreshAsync();

        await RefreshConversationTokenInputsAsync();
    }

    private async Task ConnectTerminalAsync(bool trustPresentedHostKey)
    {
        if (_selectedConnectionId is not Guid connectionId || _terminal is null || _connecting)
            return;

        _connecting = true;
        _terminalError = null;
        _hostKeyPrompt = null;
        _terminalStatus = "Connecting...";

        try
        {
            _terminalSize = await _terminal.FitAsync();
            await _terminal.ResetAsync();
            var result = await TerminalSession.ConnectAsync(connectionId, _terminalSize, trustPresentedHostKey);
            if (result.Connected)
            {
                _terminalConnected = true;
                _terminalStatus = $"Connected to {TerminalSession.ActiveConnection?.Name ?? "terminal"}.";
                await _terminal.FocusAsync();
            }
            else if (result.HostKeyPrompt is not null)
            {
                _hostKeyPrompt = result.HostKeyPrompt;
                _terminalStatus = "SSH host key trust required.";
            }
            else
            {
                _terminalError = result.ErrorMessage ?? "Terminal connection failed.";
                _terminalStatus = "Terminal connection failed.";
            }

            await RefreshConversationTokenInputsAsync();
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task DisconnectTerminalAsync()
    {
        await TerminalSession.DisconnectAsync();
        _terminalConnected = false;
        _terminalStatus = "Disconnected.";
        await RefreshConversationTokenInputsAsync();
    }

    private async Task SendTerminalInputAsync(string data)
    {
        if (!_terminalConnected)
            return;

        await TerminalSession.SendAsync(data);
    }

    private async Task ResizeTerminalAsync(TerminalSize size)
    {
        _terminalReady = true;
        _terminalSize = size;
        StartTerminalOutputPump();
        if (_terminalConnected)
            await TerminalSession.ResizeAsync(size);
    }

    private void DismissHostKeyPrompt()
    {
        _hostKeyPrompt = null;
        _terminalStatus = "SSH host key trust cancelled.";
    }

    private void ClearTerminalError()
    {
        _terminalError = null;
    }

    private void RefreshConversationTokenInputs()
    {
        _systemPrompt = AssistantPromptBuilder.Build(TerminalSession.GetSnapshot(), _noteContext);
        _toolDefinitions = BuildToolDefinitions();
        UpdateConversationTokenCount();
    }

    private async Task RefreshConversationTokenInputsAsync()
    {
        _noteContext = await LoadAssistantNoteContextAsync();
        RefreshConversationTokenInputs();
    }

    private async Task<AssistantNoteContext> LoadAssistantNoteContextAsync()
    {
        var connectionId = _selectedConnectionId ?? TerminalSession.ActiveConnection?.Id;
        if (connectionId is null)
            return AssistantNoteContext.Unavailable("No workspace connection is selected.");

        var connectionName = SelectedConnectionName ?? TerminalSession.ActiveConnection?.Name;
        try
        {
            var summaries = await NoteService.ListAsync(connectionId.Value);
            return AssistantNoteContext.Available(connectionId.Value, connectionName, summaries);
        }
        catch (Exception ex)
        {
            return AssistantNoteContext.Unavailable(ex.Message);
        }
    }

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            _persistedMessages,
            ToTokenMessage,
            _live,
            new TokenCountRequest(_activeProvider?.ModelId),
            _pendingUserText,
            _systemPrompt,
            _toolDefinitions);
    }

    private List<string> BuildToolDefinitions()
    {
        var tools = ToolRegistry.Build(new AssistantToolContext(TerminalSession, WorkspaceConnection, CancellationToken.None));
        return tools.OfType<AIFunction>().Select(ToToolDefinition).ToList();
    }

    private static string ToToolDefinition(AIFunction function)
    {
        var sb = new StringBuilder();
        sb.Append("Name: ").AppendLine(function.Name);
        if (!string.IsNullOrWhiteSpace(function.Description))
            sb.Append("Description: ").AppendLine(function.Description);

        var schema = function.JsonSchema;
        if (schema.ValueKind != JsonValueKind.Undefined)
        {
            sb.AppendLine("Parameters:");
            sb.AppendLine(schema.GetRawText());
        }

        return sb.ToString();
    }

    private static ChatTranscriptTokenMessage ToTokenMessage(AssistantMessage message) => new(
        message.Role.ToString(),
        message.Content,
        message.ToolCallsJson,
        message.ToolCallId,
        message.ToolName,
        message.ErrorMessage);

    private static List<ChatRenderableMessage> ToRenderable(IReadOnlyList<AssistantMessage> messages)
    {
        var toolRowsByCallId = messages
            .Where(message => message.Role == AssistantMessageRole.Tool && !string.IsNullOrWhiteSpace(message.ToolCallId))
            .GroupBy(message => message.ToolCallId!, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last(), StringComparer.Ordinal);

        var renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var message in messages)
        {
            if (message.Role is AssistantMessageRole.System or AssistantMessageRole.Tool)
                continue;

            renderable.Add(new ChatRenderableMessage(
                message.Id,
                ToChatRole(message.Role),
                ToChatStatus(message.Status),
                BuildMessageParts(message, toolRowsByCallId)));
        }

        return renderable;
    }

    private static ChatMessageRole ToChatRole(AssistantMessageRole role) =>
        role == AssistantMessageRole.User ? ChatMessageRole.User : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(AssistantMessageStatus status) => status switch
    {
        AssistantMessageStatus.Failed => ChatMessageStatus.Failed,
        AssistantMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        AssistantMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed
    };

    private static List<ChatMessagePart> BuildMessageParts(
        AssistantMessage message,
        IReadOnlyDictionary<string, AssistantMessage> toolRowsByCallId)
    {
        if (message.Role != AssistantMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        var text = message.Content ?? string.Empty;
        var cursor = 0;
        foreach (var call in calls.OrderBy(call => call.TextOffset ?? int.MaxValue))
        {
            var offset = Math.Clamp(call.TextOffset ?? text.Length, 0, text.Length);
            if (offset > cursor)
                parts.Add(new ChatTextPart(text[cursor..offset]));

            parts.Add(new ChatToolPart(BuildToolChip(call, toolRowsByCallId)));
            cursor = Math.Max(cursor, offset);
        }

        if (cursor < text.Length)
            parts.Add(new ChatTextPart(text[cursor..]));

        return parts;
    }

    private static ChatToolChip BuildToolChip(
        ChatPersistedToolCall call,
        IReadOnlyDictionary<string, AssistantMessage> toolRowsByCallId)
    {
        var chip = new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson, argumentsComplete: true);
        if (!toolRowsByCallId.TryGetValue(call.CallId, out var toolRow))
            return chip;

        chip.Completed = toolRow.Status != AssistantMessageStatus.Pending;
        chip.Result = toolRow.Content;
        if (toolRow.Status == AssistantMessageStatus.Failed)
        {
            chip.Error = string.IsNullOrWhiteSpace(toolRow.ErrorMessage)
                ? "Tool call failed."
                : toolRow.ErrorMessage;
        }

        return chip;
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        TerminalSession.StateChanged -= OnTerminalStateChanged;
        ChatRuntime.StateChanged -= OnChatRuntimeStateChanged;
        ChatRuntime.NotesChanged -= OnChatRuntimeNotesChanged;
        _outputCts?.Cancel();
        _outputCts?.Dispose();
        _outputCts = null;
        _terminal = null;
        _notesDrawer = null;
        return ValueTask.CompletedTask;
    }
}
