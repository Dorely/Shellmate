{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Desktop": {
    "BindHost": "localhost",
    "HttpPort": 1455
  },
  "Auth": {
    "Codex": {
      "RedirectUri": "http://localhost:1455/auth/callback"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=shellmate.db"
  },
  "Persistence": {
    "Provider": "Sqlite"
  },
  "Blazor": {
    "MaximumReceiveMessageSizeBytes": 67108864
  },
  "Agents": {
    "MaxToolIterations": 12,
    "CodexRequestTimeoutSeconds": 600,
    "TerminalRecentOutputMaxChars": 12000,
    "TerminalCommandOutputMaxChars": 20000,
    "TerminalRecentCommandCount": 12,
    "TerminalCommandTimeoutSeconds": 60
  }
}
