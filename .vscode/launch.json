{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shellmate Electron",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite",
      "windows": { "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite.cmd" },
      "runtimeArgs": ["--sourcemap"],
      "env": { "REMOTE_DEBUGGING_PORT": "9222" },
      "presentation": { "order": 1 }
    },
    {
      "name": "Shellmate Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 60000,
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [{ "name": "Debug Shellmate", "configurations": ["Shellmate Electron", "Shellmate Renderer"] }]
}
