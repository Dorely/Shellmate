{
  "name": "shellmate",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop remote connection manager with a visible AI assistant",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "browser": "npm run build && electron . --browser",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -o better-sqlite3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "13.0.3",
    "js-tiktoken": "1.0.21",
    "node-pty": "^1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "^1.17.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "^1.15.0",
    "@electron/rebuild": "4.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
